# Tekken Agent Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Backend Selection
# ============================================================================
# Options: "anthropic" (default) | "openai"
TEKKEN_AGENT_BACKEND=anthropic

# ============================================================================
# Anthropic Backend (default)
# ============================================================================
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model options: claude-opus-4, claude-sonnet-4-6, claude-haiku-4-5
# Sonnet (default) - balanced speed/quality
# Haiku - faster, cheaper (good for menu grinding)
# Opus - best reasoning (better neutral game decisions)
TEKKEN_AGENT_MODEL=claude-sonnet-4-6

# ============================================================================
# OpenAI-Compatible Backend (alternative)
# ============================================================================
# Uncomment and configure if using TEKKEN_AGENT_BACKEND=openai

# OpenAI Official
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-xxxxx
# TEKKEN_AGENT_MODEL=gpt-4o

# OpenRouter
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-xxxxx
# TEKKEN_AGENT_MODEL=google/gemini-2.0-flash-001

# Ollama (local, vision-capable models only)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# TEKKEN_AGENT_MODEL=qwen2.5-vl:7b

# LM Studio (local)
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=lm-studio
# TEKKEN_AGENT_MODEL=your-loaded-vision-model

# vLLM (local server)
# OPENAI_BASE_URL=http://localhost:8000/v1
# OPENAI_API_KEY=vllm
# TEKKEN_AGENT_MODEL=your-vision-model

# ============================================================================
# Emulator & Game Configuration
# ============================================================================
# Emulator: rpcs3 (default) | duckstation
TEKKEN_EMULATOR=rpcs3

# Game: tekken6 (default, for RPCS3) | tekken3 (for DuckStation)
TEKKEN_GAME=tekken6

# ============================================================================
# Agent Behavior (optional overrides)
# ============================================================================
# Default cycles before auto-stop (can override with --cycles CLI arg)
# TEKKEN_AGENT_MAX_CYCLES=200

# Player side: left (default) | right
# TEKKEN_AGENT_SIDE=left

# Screenshot downscale width (smaller = faster API calls, less detail)
# TEKKEN_AGENT_MAX_WIDTH=1024

# JPEG quality for screenshots (1-100)
# TEKKEN_AGENT_JPEG_QUALITY=80
